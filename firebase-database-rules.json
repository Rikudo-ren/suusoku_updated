{
  "rules": {
    "players": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChild('name')",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12"
        },
        "$other": { ".validate": false }
      }
    },

    "playerNames": {
      "$normName": {
        ".read": true,
        ".write": "auth != null && (data.val() === auth.uid || !data.exists()) && (!newData.exists() || newData.val() === auth.uid)",
        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
      }
    },

    "siteStats": {
      "visits": {
        ".read": true,
        ".write": "auth != null",
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)"
      }
    },

    "rankings": {
      "$mode": {
        "$difficulty": {
          ".read": true,
          ".write": "auth != null",
          ".indexOn": ["score"],
          "$entryId": {
            ".validate": "newData.hasChildren(['uid','score','solved','misses','maxCombo','ts'])",
            "uid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999" },
            "solved": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "misses": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "maxCombo": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "ts": { ".validate": true },
            "$other": { ".validate": false }
          }
        }
      },
      ".read": false,
      ".write": false
    }
  }
}
